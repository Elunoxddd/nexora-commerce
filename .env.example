# Número comercial público para crear enlaces wa.me (no es un secreto).
NEXT_PUBLIC_WHATSAPP_NUMBER=573503728766

# Acceso a Google Sheets. Comparte la hoja con este service account como editor.
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Cloudinary. API secret permanece solo en el servidor.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Protección del panel: genera el hash con `node scripts/hash-admin-password.mjs`.
ADMIN_PASSWORD_HASH=
# Genera con `openssl rand -base64 32` (32 caracteres mínimos).
ADMIN_SESSION_SECRET=
